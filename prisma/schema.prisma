generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum MediaType {
  SERIES
  MOVIE
}

enum WatchStatus {
  PLAN_TO_WATCH
  WATCHING
  ON_HOLD
  COMPLETED
  DROPPED
}

model Title {
  id             String      @id @default(cuid())
  name           String
  type           MediaType   @default(SERIES)
  status         WatchStatus @default(PLAN_TO_WATCH)
  posterUrl      String?
  watchUrl       String?
  tags           String      @default("")
  currentSeason  Int         @default(1)
  currentEpisode Int         @default(0)
  totalSeasons   Int?
  totalEpisodes  Int?
  rating         Int?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}
